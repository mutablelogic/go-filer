{
    "name": "@mutablelogic/go-filer",
    "version": "0.0.0",
    "description": "go-filer's web UI modules, such as Files, which an app can include, and the filer server's app",
    "license": "Apache-2.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mutablelogic/go-filer.git",
        "directory": "frontend"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "files": [
        "dist"
    ],
    "exports": {
        "./filer": {
            "types": "./dist/filer/index.d.ts",
            "import": "./dist/filer/index.js"
        },
        "./tree": {
            "types": "./dist/tree/controller.d.ts",
            "import": "./dist/tree/controller.js"
        },
        "./tree/view": {
            "types": "./dist/tree/view.d.ts",
            "import": "./dist/tree/view.js"
        },
        "./volumes": {
            "types": "./dist/volumes/controller.d.ts",
            "import": "./dist/volumes/controller.js"
        },
        "./volumes/view": {
            "types": "./dist/volumes/view.d.ts",
            "import": "./dist/volumes/view.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "build-app": "node app/build.js",
        "check": "tsc -p tsconfig.json",
        "test": "node --test 'test/**/*.test.ts'"
    },
    "engines": {
        "node": ">=22.18"
    },
    "peerDependencies": {
        "@carbon/icons": "^11.92.0",
        "@carbon/web-components": "^2.67.0",
        "@mutablelogic/go-server": "^1.8.24",
        "lit": "^3.3.3"
    },
    "devDependencies": {
        "@carbon/icons": "^11.92.0",
        "@carbon/styles": "^1.119.0",
        "@carbon/web-components": "^2.67.0",
        "@ibm/plex-mono": "^2.5.0",
        "@ibm/plex-sans": "^1.1.0",
        "@mutablelogic/go-server": "^1.8.24",
        "@types/node": "^24.19.2",
        "esbuild": "^0.25.12",
        "lit": "^3.3.3",
        "typescript": "^5.9.3"
    }
}
